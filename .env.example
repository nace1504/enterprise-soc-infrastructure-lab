# =========================================================
# Enterprise SOC Infrastructure Lab: mẫu biến môi trường
# ---------------------------------------------------------
# Sao chép thành `.env` và điền giá trị trên MÁY CỤC BỘ.
# Tuyệt đối không commit `.env`.
# Mọi giá trị được cố ý để trống. Không thêm secret, địa chỉ IP
# hay phiên bản thật hoặc trông giống thật vào file này.
# Kế hoạch địa chỉ và phiên bản vẫn là TBD (xem README).
# Một số biến phụ thuộc vào quyết định còn mở (xem mục 4.2 của
# CLAUDE.md). Để trống các biến đó cho tới khi có ADR ở trạng thái Accepted.
# Việc một biến có mặt trong file này KHÔNG có nghĩa phương án liên quan
# đã được chọn.
# =========================================================

# ---------- Phân đoạn mạng (kế hoạch địa chỉ TBD) ----------
# WAN_SUBNET phụ thuộc chế độ kết nối WAN trên VMware (UNDECIDED).
# Chưa xác định dải WAN, và dải này có thể không thuộc quyền kiểm soát
# của lab (ví dụ do VMware hoặc mạng bên ngoài cấp). Có thể không cần dùng.
WAN_SUBNET=
DMZ_SUBNET=
LAN_SUBNET=
SOC_SUBNET=

# ---------- pfSense ----------
# Địa chỉ giao diện quản trị pfSense. Không ngụ ý có phân đoạn quản trị
# riêng (phân đoạn quản trị riêng là quyết định còn mở).
PFSENSE_MGMT_HOST=
PFSENSE_ADMIN_USER=
PFSENSE_ADMIN_PASSWORD=

# ---------- WAF / DVWA (máy ảo Ubuntu) ----------
WAF_HOST=
# Phụ thuộc quyết định chưa chốt: vị trí cơ sở dữ liệu của DVWA (UNDECIDED).
# Biến chỉ giữ chỗ; chưa có phương án nào được chọn. Để trống.
DVWA_DB_PASSWORD=
DVWA_ADMIN_PASSWORD=

# ---------- Active Directory ----------
AD_DOMAIN_FQDN=
AD_NETBIOS_NAME=
AD_DC_HOST=
AD_ADMIN_USER=
AD_ADMIN_PASSWORD=
AD_DSRM_PASSWORD=

# ---------- Wazuh (vị trí đặt UNDECIDED) ----------
WAZUH_MANAGER_HOST=
WAZUH_DASHBOARD_USER=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Phụ thuộc quyết định chưa chốt: phương thức đăng ký Wazuh agent (UNDECIDED).
# Chưa chọn password-based enrollment hay phương thức khác. Biến chỉ liên quan
# nếu sau này chọn phương thức dùng password. Để trống.
WAZUH_AGENT_ENROLLMENT_PASSWORD=
