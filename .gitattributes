# =========================================================
# Enterprise SOC Infrastructure Lab: .gitattributes
# Thống nhất line ending giữa Windows và Linux.
# Phải khớp với .editorconfig: mặc định LF; PowerShell, bat, cmd dùng CRLF.
# Phần mở rộng binary dùng lớp ký tự [Aa] để khớp cả chữ hoa khi
# core.ignorecase=false (Linux).
# =========================================================

* text=auto eol=lf

*.md    text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.conf  text eol=lf
*.php   text eol=lf
*.dist  text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.svg   text eol=lf
.env.example text eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

