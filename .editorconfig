root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{ps1,psm1,psd1}]
# Windows PowerShell 5.1 chỉ đọc đúng UTF-8 (chú thích tiếng Việt) khi có BOM
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
